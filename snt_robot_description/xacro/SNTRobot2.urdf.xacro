<?xml version="1.0"?>
<robot name="SNTRobot2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====== 파라미터 ====== -->
  <xacro:property name="box_x" value="0.06"/>
  <xacro:property name="box_y" value="0.06"/>

   <!-- ====== 파라미터 ====== -->
  <xacro:property name="box_x2" value="0.001"/>
  <xacro:property name="box_y2" value="0.001"/>

  <!-- 링크 길이 -->
  <xacro:property name="L1" value="0.35"/>
  <xacro:property name="L2" value="0.40"/>
  <xacro:property name="L3" value="0.40"/>

  <!-- Wrist -->
  <xacro:property name="L6" value="0.10"/>

  <!-- ====== 재질 ====== -->
  <material name="mat_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="mat_orange">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>

  <!-- ====== 관성 ====== -->
  <xacro:macro name="simple_inertial" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0"
               izz="0.01"/>
    </inertial>
  </xacro:macro>

  <!-- ====== 링크 박스 ====== -->
  <xacro:macro name="link_box" params="name length material_name">
    <link name="${name}">
      <xacro:simple_inertial mass="1.0"/>

      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${box_x} ${box_y} ${length}"/>
        </geometry>
        <material name="${material_name}"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${box_x} ${box_y} ${length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

    <!-- ====== 링크 박스 ====== -->
  <xacro:macro name="small_box" params="name length material_name">
    <link name="${name}">
      <xacro:simple_inertial mass="1.0"/>

      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${box_x2} ${box_y2} ${length}"/>
        </geometry>
        <material name="${material_name}"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${box_x2} ${box_y2} ${length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>


  <!-- ====== 조인트 ====== -->
  <xacro:macro name="rev_joint" params="name parent child xyz rpy axis">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ====== base ====== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="0.20 0.20 0.10"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="0.20 0.20 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- ====== Arm (1~3) ====== -->
  <xacro:link_box name="link1" length="${L1}" material_name="mat_black"/>
  <xacro:link_box name="link2" length="${L2}" material_name="mat_orange"/>
  <xacro:link_box name="link3" length="${L3}" material_name="mat_black"/>
  <xacro:small_box name="link4" length="0.01" material_name="mat_black"/>
  <xacro:small_box name="link5" length="0.01" material_name="mat_orange"/>
  <xacro:link_box name="link6" length="${L6}" material_name="mat_orange"/>


  <!-- ====== Joint 1~3 (위치) ====== -->
  <xacro:rev_joint name="joint1"
    parent="base_link" child="link1"
    xyz="0 0 0.10" rpy="0 0 0"
    axis="0 0 1"/>

  <xacro:rev_joint name="joint2"
    parent="link1" child="link2"
    xyz="0 0 ${L1}" rpy="0 0 0"
    axis="0 1 0"/>

  <xacro:rev_joint name="joint3"
    parent="link2" child="link3"
    xyz="0 0 ${L2}" rpy="0 0 0"
    axis="0 1 0"/>

  <!-- ====== Joint 4~6 (Spherical Wrist 핵심) ====== -->

  <!-- 한 점 기준 -->
  <xacro:rev_joint name="joint4"
    parent="link3" child="link4"
    xyz="0 0 ${L3}" rpy="0 0 0"
    axis="1 0 0"/>

  <xacro:rev_joint name="joint5"
    parent="link4" child="link5"
    xyz="0 0 0" rpy="0 0 0"
    axis="0 1 0"/>

  <xacro:rev_joint name="joint6"
    parent="link5" child="link6"
    xyz="0 0 0" rpy="0 0 0"
    axis="0 0 1"/>

</robot>